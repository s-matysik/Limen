{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://limen.dev/schemas/arch-facts-1.json",
  "title": "limen extracted facts, version 1",
  "type": "object",
  "required": ["schema", "generated_by", "root", "language", "root_path", "files", "unresolved"],
  "properties": {
    "schema": { "enum": ["arch-facts/1"] },
    "generated_by": { "type": "string" },
    "root": { "type": "string" },
    "language": { "type": "string" },
    "root_path": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "declares", "lines", "deps"],
        "properties": {
          "path": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "layer": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "declares": { "type": "array", "items": { "type": "string" } },
          "lines": { "type": "integer", "minimum": 0 },
          "deps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "line", "via"],
              "properties": {
                "target": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "via": { "enum": ["use", "import", "require", "extends", "implements", "annotation", "text"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "raw", "reason"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "raw": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
